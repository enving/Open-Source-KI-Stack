# Firmenwerte für die Wiki-Vorlage (scripts/llm-wiki-einrichten.sh <Compose-env-Datei> <diese Datei>).
# Kopie lokal anlegen, nicht ins Repo. Ersetzt die Platzhalter {{…}} beim ersten Anlegen der Dateien.
FIRMA_NAME="Beispielfirma GmbH"
FIRMA_KURZ="Kurzbeschreibung: was die Firma anbietet und für wen."
# Open-WebUI-Konto (E-Mail), das alle Bereiche besitzt, bis sie verteilt sind
BESITZER_STANDARD="admin@firma.invalid"
# Modell-ID des Codex-Agenten in Open WebUI (Admin > Modelle, Eintrag agent:open-terminal:codex:…)
CODEX_MODELL="agent:open-terminal:codex:gpt-6-luna"
CRM="noch kein CRM (Lücke)"
CRM_ZUGANG="keiner"
