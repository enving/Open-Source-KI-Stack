# Vorlage für .env. Nur Namen, keine Werte: Geheimnisse gehören in die lokale .env (gitignored).
# Kopieren mit: cp .env.example .env  und die Werte eintragen.
# Erzeugen: openssl rand -hex 32

# Open Terminal (docker-compose.open-terminal.yml)
OPEN_TERMINAL_API_KEY=

# OpenWebUI
WEBUI_SECRET_KEY=
WEBUI_NAME=
WEBUI_URL=
WEBUI_AUTH=
FRONTEND_BUILD_DIR=

# SearXNG (wird von beiden Compose-Dateien übergeben)
SEARXNG_SECRET=

# n8n
N8N_HOST=
N8N_PROTOCOL=
N8N_WEBHOOK_URL=
GENERIC_TIMEZONE=
POSTGRES_N8N_PASSWORD=
POSTGRES_OWUI_PASSWORD=

# Redis (testing)
REDIS_PASSWORD=

# Qdrant / Crawl4AI / Docling
QDRANT_API_KEY=
CRAWL4AI_API_TOKEN=
DOCLING_API_KEY=
DOCLING_VLM_PIPELINE_MODEL_LOCAL=

# IONOS (Beispiel-Anbieter für OpenAI-kompatible API und Managed PostgreSQL)
IONOS_TOKEN=
IONOS_BASE_URL=
IONOS_OPENAI_MODEL=
IONOS_POSTGRES_HOST=
IONOS_POSTGRES_PORT=
IONOS_POSTGRES_DB=
IONOS_POSTGRES_USER=
IONOS_POSTGRES_PASSWORD=
IONOS_POSTGRES_URL=

# LDAP (auskommentiert in docker-compose.testing.yml)
LDAP_BIND_PASSWORD=

# Erweiterter Stack (docker-compose.erweitert.yml)
# WEBUI_SECRET_KEY und OPEN_TERMINAL_API_KEY stehen oben.
FIRECRAWL_DB_PASSWORD=
BULL_AUTH_KEY=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# n8n im erweiterten Stack (Schlüssel: openssl rand -hex 32; Adressen nur bei Zugriff über Tailscale Serve)
N8N_ENCRYPTION_KEY=
# N8N_EDITOR_BASE_URL=https://<rechner>.<tailnet>.ts.net:10001
# N8N_WEBHOOK_URL=https://<rechner>.<tailnet>.ts.net:10001
